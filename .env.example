# Open Hémicycle — variables d'environnement (exemple)
# Copier en .env (NON commité) et remplir.

# --- PostgreSQL / Supabase ---
# SEULE clé requise pour Drizzle (ETL + runtime) : la connexion Postgres porte
# déjà tous les droits et contourne la RLS. Supabase: Connect > ORM > Drizzle,
# Transaction pooler IPv4 (port 6543). Remplacer [YOUR-PASSWORD].
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Supabase — URL + clé publishable (sûres côté client)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Optionnel — uniquement si on utilise le SDK supabase-js (PostgREST) côté serveur.
# Inutile pour l'ETL Drizzle. Nouveau format = clé "sb_secret_..." (onglet API Keys).
# SUPABASE_SECRET_KEY="sb_secret_..."

# --- ETL enrichissement LLM (4.8) ---
# Clé OpenRouter pour classification scrutin → thème (secret superviseur).
# OPENROUTER_API_KEY="sk-or-..."

# --- ETL ---
# Législature courante
AN_LEGISLATURE="17"
# Dossier de stockage des dumps bruts (non commité, relatif à la racine du monorepo)
DATA_RAW_DIR="./data/raw"

# --- Admin /admin (OAuth GitHub mono-compte + APIs) ---
# Générer : openssl rand -base64 32
NEXTAUTH_SECRET=""
# URL publique de l'app (obligatoire en prod pour OAuth)
NEXTAUTH_URL="http://localhost:3000"
# OAuth App GitHub : Settings → Developer settings → OAuth Apps
# Callback prod : https://open-hemicycle.vercel.app/api/auth/callback/github
# Callback local : http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
ADMIN_GITHUB_LOGIN="kecyf"

# Fine-grained PAT (repo kecyf/open-hemicycle) : Contents R/W, Pull requests R/W, Actions R, Metadata R
GITHUB_ADMIN_TOKEN=""
GITHUB_REPO_OWNER="kecyf"
GITHUB_REPO_NAME="open-hemicycle"

# Vercel : Account Settings → Tokens ; Project Settings → General → Project ID
VERCEL_ACCESS_TOKEN=""
VERCEL_PROJECT_ID=""
# VERCEL_TEAM_ID=""  # optionnel si projet sous une team

# Cursor : Dashboard → Integrations / API Keys
CURSOR_API_KEY=""
